#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "mImageViewer\0"
      VALUE "FileDescription", "@EFFETUNE_PLUGIN_PACKAGE_NAME@\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "@EFFETUNE_PLUGIN_PACKAGE_NAME@\0"
      VALUE "LegalCopyright", "Copyright (c) 2026, Yoshiyuki Kobayashi\0"
      VALUE "OriginalFilename", "@EFFETUNE_PLUGIN_PACKAGE_NAME@.vst3\0"
      VALUE "ProductName", "@EFFETUNE_PLUGIN_PACKAGE_NAME@\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
